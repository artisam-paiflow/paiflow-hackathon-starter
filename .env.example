# Server-only configuration. Missing PAIFLOW_MODE defaults to prepare.
# prepare: no wallet actions, payments or event polling.
# At your event’s integration start, explicitly select team (your deployment) or demo (shared XLM).
PAIFLOW_MODE=prepare
PAIFLOW_BASE_URL=https://beta.paiflow.xyz
PAIFLOW_API_TOKEN=
PAIFLOW_DEPLOYMENT_ID=
